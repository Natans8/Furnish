<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- The window's layout, read top to bottom as where the sets come from, which of them, and
	     where they go. Every offset is the design's, at the 400 by 628 the window opens at: what
	     hangs from the top stays there, what stands on the bottom stays there, and the set list
	     takes whatever height the window gains. What it does is in Window.lua, which loads after
	     this file and sets every word. -->

	<!-- One row of the set list: a set's index, name, whether the WMO draws it already, and its
	     object count. -->
	<Button name="FurnishSetRowTemplate" virtual="true">
		<Size y="22"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Selected" setAllPoints="true" hidden="true">
					<Color r="1" g="0.82" b="0" a="0.14"/>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="Accent" hidden="true">
					<Size x="2"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<Color r="1" g="0.82" b="0" a="0.9"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Index" inherits="GameFontNormal" justifyH="RIGHT">
					<Size x="26"/>
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Count" inherits="GameFontDisableSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" x="-8"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Tag" inherits="GameFontGreenSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" x="-44"/>
					</Anchors>
				</FontString>
				<!-- The name ends where the tag begins, which is where the count's column begins
				     while there is no tag. -->
				<FontString parentKey="Label" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" x="36"/>
						<Anchor point="RIGHT" relativeKey="$parent.Tag" relativePoint="LEFT" x="-6"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture setAllPoints="true">
					<Color r="1" g="1" b="1" a="0.07"/>
				</Texture>
			</Layer>
		</Layers>
	</Button>

	<!-- One choice of a segmented control: its words, lit as a chosen set row is when it is the one
	     in force, a hairline between it and the one before, and room for the alert mark. Window.lua
	     lays the segments out, each as wide as its words. -->
	<Button name="FurnishSegmentTemplate" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Chosen" setAllPoints="true" hidden="true">
					<Color r="1" g="0.82" b="0" a="0.14"/>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="Accent" hidden="true">
					<Size y="2"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<Color r="1" g="0.82" b="0" a="0.9"/>
				</Texture>
				<Texture parentKey="Divider">
					<Size x="1"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<Color r="0.54" g="0.54" b="0.54" a="0.55"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontHighlightSmall" wordwrap="false"/>
				<Texture parentKey="Alert" file="Interface\DialogFrame\UI-Dialog-Icon-AlertNew" hidden="true">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="RIGHT" relativeKey="$parent.Label" relativePoint="LEFT" x="-3"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture setAllPoints="true">
					<Color r="1" g="1" b="1" a="0.07"/>
				</Texture>
			</Layer>
		</Layers>
	</Button>

	<!-- One WMO a search found: its name, marked where it comes unfurnished, and its set count.
	     Picked is the match Enter takes, lit as Blizzard's own search lists light it. -->
	<Button name="FurnishResultRowTemplate" virtual="true">
		<Size y="22"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Picked" atlas="search-highlight" setAllPoints="true" hidden="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Count" inherits="GameFontDisableSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" x="-8"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Tag" inherits="GameFontGreenSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" x="-56"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Label" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" x="8"/>
						<Anchor point="RIGHT" relativeKey="$parent.Tag" relativePoint="LEFT" x="-6"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture setAllPoints="true">
					<Color r="1" g="1" b="1" a="0.07"/>
				</Texture>
			</Layer>
		</Layers>
	</Button>

	<!-- Follow selection: ticked, the block it stands in follows what is selected; unticked, it
	     keeps what it shows. Its words stand to its left, so it sits at the right edge. -->
	<CheckButton name="FurnishFollowTemplate" inherits="UICheckButtonTemplate" virtual="true">
		<Size x="22" y="22"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" relativePoint="LEFT" x="-3" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</CheckButton>

	<!-- One number of the position: its axis word inside the box's left edge, in the box's own
	     font so the two share a baseline, and the value set in after it by Window.lua. -->
	<EditBox name="FurnishNumberTemplate" inherits="InputBoxTemplate" autoFocus="false" letters="14" virtual="true">
		<Size x="100" y="20"/>
		<Layers>
			<!-- A faint wash while the pointer rests on the box, shown by Window.lua, over the
			     border art that reaches five units left of the box. -->
			<Layer level="BACKGROUND">
				<Texture parentKey="Hover" alphaMode="ADD" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="-5" y="0"/>
						<Anchor point="BOTTOMRIGHT" x="0" y="0"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="0.12"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Axis" inherits="ChatFontNormal" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" x="2" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</EditBox>

	<!-- How many chosen sets a list hides past one of its ends, a whole row high, beside an arrow
	     pointing there; a click scrolls to the nearest. -->
	<Button name="FurnishMoreTemplate" virtual="true" hidden="true">
		<Size y="22"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture setAllPoints="true">
					<Color r="0.043" g="0.043" b="0.043" a="1"/>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="Edge">
					<Size y="1"/>
					<Color r="1" g="0.82" b="0" a="0.45"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Arrow">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="LEFT" x="6" y="0"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" x="24" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Button>

	<!-- A list in a bordered box, with its scroll bar, its edge counts and a line said where it is
	     empty. The scroll bar shows only while there is somewhere to scroll. -->
	<Frame name="FurnishListTemplate" inherits="BackdropTemplate" virtual="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString parentKey="Empty" inherits="GameFontDisable" justifyH="CENTER" justifyV="MIDDLE">
					<Anchors>
						<Anchor point="TOPLEFT" x="20" y="-20"/>
						<Anchor point="BOTTOMRIGHT" x="-20" y="20"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
				<Anchors>
					<Anchor point="TOPLEFT" x="8" y="-8"/>
					<Anchor point="BOTTOMRIGHT" x="-22" y="8"/>
				</Anchors>
			</Frame>
			<EventFrame parentKey="ScrollBar" inherits="WowTrimScrollBar">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-4" y="-6"/>
					<Anchor point="BOTTOMRIGHT" x="-4" y="6"/>
				</Anchors>
			</EventFrame>
			<Button parentKey="Above" inherits="FurnishMoreTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox"/>
					<Anchor point="TOPRIGHT" relativeKey="$parent.ScrollBox"/>
				</Anchors>
			</Button>
			<Button parentKey="Below" inherits="FurnishMoreTemplate">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBox"/>
				</Anchors>
			</Button>
		</Frames>
	</Frame>

	<Frame name="FurnishFrame" parent="UIParent" toplevel="true" movable="true" resizable="true" enableMouse="true" clampedToScreen="true" hidden="true">
		<Size x="400" y="668"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<!-- The room the source's picture takes at the window's right, from the search's row to
				     the ID's, the gap before it included. As drawn it is closed, only the margin the
				     rows keep from the edge; Window.lua opens it where Glimpse's WMO pictures are
				     installed. What is anchored to its left stands beside the picture. -->
				<Texture parentKey="PictureRoom">
					<Size x="6" y="1"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="-14" y="-38"/>
					</Anchors>
				</Texture>
				<!-- Where the sets come from, in the rows beside the picture: the search, the WMO's name,
				     what it is, its follow box, and its ID on the picture's foot. -->
				<FontString parentKey="SourceLabel" inherits="GameFontNormal" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" x="20" y="-74"/>
					</Anchors>
				</FontString>
				<FontString parentKey="SourceName" inherits="GameFontHighlightMedium" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="TOPLEFT" x="96" y="-72"/>
						<Anchor point="TOPRIGHT" relativeKey="$parent.PictureRoom" relativePoint="TOPLEFT" x="0" y="-34"/>
					</Anchors>
				</FontString>
				<FontString parentKey="SourceDetail" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="TOPLEFT" x="96" y="-92"/>
						<Anchor point="TOPRIGHT" relativeKey="$parent.PictureRoom" relativePoint="TOPLEFT" x="0" y="-54"/>
					</Anchors>
				</FontString>
				<!-- Where the sets go, the same two lines over the position below them. -->
				<FontString parentKey="DestinationLabel" inherits="GameFontNormal" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="20" y="210"/>
					</Anchors>
				</FontString>
				<!-- The leader's name, level with the middle of its segments. -->
				<FontString parentKey="LeaderLabel" inherits="GameFontNormalSmall" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativePoint="BOTTOMLEFT" x="20" y="81"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="Border" inherits="DialogBorderTranslucentTemplate"/>
			<Frame parentKey="Header" inherits="DialogHeaderTemplate"/>
			<Button parentKey="CloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-5" y="-5"/>
				</Anchors>
			</Button>

			<!-- A name: one way to fill the source's ID, with the lowest entry of the WMO picked. The
			     box's border art reaches five units left of the box itself. -->
			<EditBox parentKey="Search" inherits="SearchBoxTemplate" autoFocus="false" letters="60">
				<Size y="20"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="25" y="-40"/>
					<Anchor point="TOPRIGHT" relativeKey="$parent.PictureRoom" relativePoint="TOPLEFT" x="0" y="-2"/>
				</Anchors>
			</EditBox>

			<CheckButton parentKey="SourceFollow" inherits="FurnishFollowTemplate">
				<Anchors>
					<Anchor point="TOPRIGHT" relativeKey="$parent.PictureRoom" relativePoint="TOPLEFT" x="0" y="-72"/>
				</Anchors>
			</CheckButton>

			<!-- The source's WMO as Glimpse's WMO pictures have it, in a box edged as the list is, as
			     deep as the rows beside it; shown by Window.lua where the pictures are installed. -->
			<Frame parentKey="PictureBox" inherits="BackdropTemplate" hidden="true">
				<Size x="138" y="138"/>
				<Anchors>
					<Anchor point="TOPRIGHT" x="-14" y="-38"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture parentKey="Picture">
							<Anchors>
								<Anchor point="TOPLEFT" x="5" y="-5"/>
								<Anchor point="BOTTOMRIGHT" x="-5" y="5"/>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</Frame>

			<!-- The gob entry the sets come from, as the destination's boxes hold its position: a third
			     of the width, sized by Window.lua with them; level with the picture's foot. -->
			<EditBox parentKey="SourceID" inherits="FurnishNumberTemplate">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" x="25" y="-176"/>
				</Anchors>
			</EditBox>
			<!-- The source's WMO itself, spawned where the player stands; as wide as its words, which
			     Window.lua sets. -->
			<Button parentKey="SpawnSource" inherits="UIPanelButtonTemplate">
				<Size y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.SourceID" relativePoint="RIGHT" x="8" y="0"/>
				</Anchors>
			</Button>

			<!-- The sets, below the source section, eleven rows at the size the window opens at, or a
			     line saying why there are none. -->
			<Frame parentKey="Sets" inherits="FurnishListTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="14" y="-182"/>
					<Anchor point="BOTTOMRIGHT" x="-14" y="228"/>
				</Anchors>
			</Frame>

			<CheckButton parentKey="DestinationFollow" inherits="FurnishFollowTemplate">
				<Anchors>
					<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" x="-20" y="200"/>
				</Anchors>
			</CheckButton>

			<!-- The position's boxes, laid across the window's width by Window.lua. -->
			<EditBox parentKey="X" inherits="FurnishNumberTemplate"/>
			<EditBox parentKey="Y" inherits="FurnishNumberTemplate"/>
			<EditBox parentKey="Z" inherits="FurnishNumberTemplate"/>
			<EditBox parentKey="Roll" inherits="FurnishNumberTemplate"/>
			<EditBox parentKey="Pitch" inherits="FurnishNumberTemplate"/>
			<EditBox parentKey="Turn" inherits="FurnishNumberTemplate"/>
			<EditBox parentKey="Scale" inherits="FurnishNumberTemplate"/>

			<!-- What fills the position, once each, each button as wide as its words, which
			     Window.lua sets. -->
			<Button parentKey="Here" inherits="UIPanelButtonTemplate">
				<Size y="22"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="18" y="118"/>
				</Anchors>
			</Button>
			<Button parentKey="UseSelected" inherits="UIPanelButtonTemplate">
				<Size y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.Here" relativePoint="RIGHT" x="4" y="0"/>
				</Anchors>
			</Button>

			<!-- What leads the objects' group, or that they form none: one choice of four, all in view,
			     in the names' column. Window.lua makes the segments. -->
			<Frame parentKey="Leader" inherits="BackdropTemplate">
				<Size y="22"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="96" y="92"/>
					<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" x="-20" y="92"/>
				</Anchors>
			</Frame>

			<!-- The status row: the client's highlighting at its right, as Tiler offers it; beside it a
			     run's progress, or what to know before the next. -->
			<Button parentKey="Highlight" inherits="UIPanelButtonTemplate">
				<Size y="20"/>
				<Anchors>
					<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" x="-18" y="64"/>
				</Anchors>
			</Button>
			<Button parentKey="Notice" hidden="true">
				<Size y="16"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="20" y="62"/>
					<Anchor point="RIGHT" relativeKey="$parent.Highlight" relativePoint="LEFT" x="-8" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Text" inherits="GameFontNormalSmall" justifyH="LEFT" wordwrap="false" setAllPoints="true"/>
					</Layer>
				</Layers>
			</Button>
			<!-- A run's progress, Blizzard's status bar; it says how the run ended until the next. -->
			<StatusBar parentKey="Progress" minValue="0" maxValue="1" defaultValue="0" hidden="true">
				<Size y="14"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="20" y="61"/>
					<Anchor point="RIGHT" relativeKey="$parent.Highlight" relativePoint="LEFT" x="-8" y="0"/>
				</Anchors>
				<BarTexture file="Interface\TargetingFrame\UI-StatusBar"/>
				<BarColor r="0.72" g="0.53" b="0.04"/>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Rim">
							<Anchors>
								<Anchor point="TOPLEFT" x="-2" y="2"/>
								<Anchor point="BOTTOMRIGHT" x="2" y="-2"/>
							</Anchors>
							<Color r="0.47" g="0.47" b="0.47" a="0.5"/>
						</Texture>
					</Layer>
					<Layer level="BORDER">
						<Texture parentKey="Background">
							<Anchors>
								<Anchor point="TOPLEFT" x="-1" y="1"/>
								<Anchor point="BOTTOMRIGHT" x="1" y="-1"/>
							</Anchors>
							<Color r="0" g="0" b="0" a="1"/>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString parentKey="Text" inherits="TextStatusBarText">
							<Anchors>
								<Anchor point="CENTER" x="0" y="0"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</StatusBar>

			<!-- Spawn, or stop a run; beside it, during a run, stop and delete. Once a run ends its
			     group is the player's. -->
			<Button parentKey="DeleteButton" inherits="UIPanelButtonTemplate" hidden="true">
				<Size x="120" y="22"/>
				<Anchors>
					<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" x="-18" y="38"/>
				</Anchors>
			</Button>
			<Button parentKey="SpawnButton" inherits="UIPanelButtonTemplate">
				<Size y="22"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="18" y="38"/>
					<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" x="-18" y="38"/>
				</Anchors>
			</Button>

			<!-- The WMOs a name finds, under the search box and as wide, opaque, over everything else. -->
			<Frame parentKey="Results" inherits="FurnishListTemplate" frameStrata="DIALOG" hidden="true">
				<Size y="200"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Search" relativePoint="BOTTOMLEFT" x="-11" y="-2"/>
					<Anchor point="TOPRIGHT" relativeKey="$parent.Search" relativePoint="BOTTOMRIGHT" x="6" y="-2"/>
				</Anchors>
			</Frame>

			<!-- The chosen sets laid out, without the WMO, which no model frame can draw: a pane against
			     the window's right edge, below the doodad panel and above the blueprint offer while
			     they show, which Window.lua sets; shown when a set is clicked. The scene fills it under
			     the names, and under the scene one line says how far the models have loaded and
			     another how to move them. -->
			<Frame parentKey="Preview" enableMouse="true" hidden="true">
				<Size x="440"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="0" y="0"/>
					<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
							<Anchors>
								<Anchor point="TOPLEFT" x="16" y="-16"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Name" inherits="GameFontHighlightMedium" justifyH="LEFT" wordwrap="false">
							<Anchors>
								<Anchor point="TOPLEFT" x="16" y="-34"/>
								<Anchor point="TOPRIGHT" x="-16" y="-34"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Detail" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
							<Anchors>
								<Anchor point="TOPLEFT" x="16" y="-54"/>
								<Anchor point="TOPRIGHT" x="-16" y="-54"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Loading" inherits="GameFontDisableSmall" justifyH="LEFT">
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="16" y="16"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Hint" inherits="GameFontDisableSmall" justifyH="RIGHT">
							<Anchors>
								<Anchor point="BOTTOMRIGHT" x="-16" y="16"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Frame parentKey="Border" inherits="DialogBorderTranslucentTemplate"/>
					<Button parentKey="CloseButton" inherits="UIPanelCloseButton">
						<Anchors>
							<Anchor point="TOPRIGHT" x="-5" y="-5"/>
						</Anchors>
					</Button>
					<ModelScene parentKey="Scene" inherits="ModelSceneMixinTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="12" y="-72"/>
							<Anchor point="BOTTOMRIGHT" x="-12" y="36"/>
						</Anchors>
						<Frames>
							<!-- The game's own model controls, as its dressing room lays them over the model:
							     zoom in, zoom out, a pan held and dragged, rotate left and right while held,
							     and reset. Half seen until the pointer is on them; Window.lua wires them. -->
							<Frame parentKey="Controls" alpha="0.5">
								<Size x="112" y="23"/>
								<Anchors>
									<Anchor point="TOP" x="0" y="-4"/>
								</Anchors>
								<Layers>
									<Layer level="BACKGROUND">
										<Texture parentKey="Right" file="Interface\Common\UI-ModelControlPanel">
											<Size x="23" y="23"/>
											<Anchors>
												<Anchor point="RIGHT"/>
											</Anchors>
											<TexCoords left="0.015625" right="0.375" top="0.4296875" bottom="0.609375"/>
										</Texture>
										<Texture parentKey="Left" file="Interface\Common\UI-ModelControlPanel">
											<Size x="23" y="23"/>
											<Anchors>
												<Anchor point="LEFT"/>
											</Anchors>
											<TexCoords left="0.40625" right="0.765625" top="0.4296875" bottom="0.609375"/>
