			<!-- The doodad `.doodad select` picked, in a panel of its own top-aligned to the window's
			     right edge, shown while there is one: its name, the sets of the WMO it is, and what it
			     gives the window, its sets to the source and itself, as a gob, to the destination. Its
			     height follows its list, set by Window.lua: the list hangs from the top, and the two
			     buttons stand on the bottom. -->
			<Frame parentKey="Doodad" enableMouse="true" hidden="true">
				<Size x="300" y="300"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="0" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
							<Anchors>
								<Anchor point="TOPLEFT" x="16" y="-16"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Name" inherits="GameFontHighlightMedium" justifyH="LEFT" wordwrap="false">
							<Anchors>
								<Anchor point="TOPLEFT" x="16" y="-34"/>
								<Anchor point="TOPRIGHT" x="-16" y="-34"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Detail" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
							<Anchors>
								<Anchor point="TOPLEFT" x="16" y="-54"/>
								<Anchor point="TOPRIGHT" x="-16" y="-54"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Frame parentKey="Border" inherits="DialogBorderTranslucentTemplate"/>
					<Button parentKey="CloseButton" inherits="UIPanelCloseButton">
						<Anchors>
							<Anchor point="TOPRIGHT" x="-5" y="-5"/>
						</Anchors>
					</Button>
					<Frame parentKey="Sets" inherits="FurnishListTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="10" y="-72"/>
							<Anchor point="BOTTOMRIGHT" x="-10" y="82"/>
						</Anchors>
					</Frame>
					<Button parentKey="UseSource" inherits="UIPanelButtonTemplate">
						<Size y="22"/>
						<Anchors>
							<Anchor point="BOTTOMLEFT" x="10" y="44"/>
							<Anchor point="BOTTOMRIGHT" x="-10" y="44"/>
						</Anchors>
					</Button>
					<Button parentKey="Import" inherits="UIPanelButtonTemplate">
						<Size y="22"/>
						<Anchors>
							<Anchor point="BOTTOMLEFT" x="10" y="16"/>
							<Anchor point="BOTTOMRIGHT" x="-10" y="16"/>
						</Anchors>
					</Button>
				</Frames>
			</Frame>

			<!-- The blueprint a whole run offers, a passing offer rather than part of the window, so it
			     wears the tooltip's backdrop, bottom-aligned to the window's right edge as the doodad
			     panel is top-aligned: why it is worth a click, a name box, and a button that puts the
			     command in the chat box. -->
			<Frame parentKey="Blueprint" inherits="TooltipBackdropTemplate" enableMouse="true" hidden="true">
				<Size x="300" y="76"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Title" inherits="GameFontNormalSmall" justifyH="LEFT">
							<Anchors>
								<Anchor point="TOPLEFT" x="10" y="-9"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Why" inherits="GameFontDisableSmall" justifyH="LEFT">
							<Anchors>
								<Anchor point="TOPLEFT" x="10" y="-25"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button parentKey="CloseButton" inherits="UIPanelCloseButton">
						<Size x="20" y="20"/>
						<Anchors>
							<Anchor point="TOPRIGHT" x="-3" y="-3"/>
						</Anchors>
					</Button>
					<Button parentKey="Paste" inherits="UIPanelButtonTemplate">
						<Size y="22"/>
						<Anchors>
							<Anchor point="BOTTOMRIGHT" x="-10" y="9"/>
						</Anchors>
					</Button>
					<EditBox parentKey="Name" inherits="InputBoxTemplate" autoFocus="false">
						<Size y="20"/>
						<Anchors>
							<Anchor point="BOTTOMLEFT" x="15" y="10"/>
							<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Paste" relativePoint="BOTTOMLEFT" x="-6" y="1"/>
						</Anchors>
					</EditBox>
				</Frames>
			</Frame>

			<!-- Drags the window's corner; the list takes whatever height it gains. -->
			<Button parentKey="Grip">
				<Size x="16" y="16"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
				</Anchors>
				<NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
				<PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
				<HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight" alphaMode="ADD"/>
			</Button>
		</Frames>
	</Frame>
</Ui>
