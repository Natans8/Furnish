<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- The window's layout, after ObjectMover's: a dark dialog of bordered panels, each with a
	     gold title. What it does is in Window.lua, which loads after this file and gives the
	     panels their borders. -->

	<!-- One set in the list: its index, its name, and how many objects it holds. -->
	<Button name="FurnishSetRowTemplate" virtual="true">
		<Size y="22"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Selected" setAllPoints="true" hidden="true">
					<Color r="1" g="0.82" b="0" a="0.14"/>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture parentKey="Accent" hidden="true">
					<Size x="2"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<Color r="1" g="0.82" b="0" a="0.9"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString parentKey="Index" inherits="GameFontNormal" justifyH="RIGHT">
					<Size x="26"/>
					<Anchors>
						<Anchor point="LEFT" x="4"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Count" inherits="GameFontDisableSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" x="-8"/>
					</Anchors>
				</FontString>
				<!-- "on the map" where a selected map WMO draws this set, else empty. -->
				<FontString parentKey="Tag" inherits="GameFontGreenSmall" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT" relativeKey="$parent.Count" relativePoint="LEFT" x="-8"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Label" inherits="GameFontHighlight" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Index" relativePoint="RIGHT" x="10"/>
						<Anchor point="RIGHT" relativeKey="$parent.Tag" relativePoint="LEFT" x="-6"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture setAllPoints="true">
					<Color r="1" g="1" b="1" a="0.06"/>
				</Texture>
			</Layer>
		</Layers>
	</Button>

	<Frame name="FurnishFrame" parent="UIParent" toplevel="true" movable="true" enableMouse="true" clampedToScreen="true" hidden="true">
		<Size x="340" y="470"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Hint" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="18" y="15"/>
						<Anchor point="BOTTOMRIGHT" x="-124" y="15"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="Border" inherits="DialogBorderTranslucentTemplate"/>
			<Frame parentKey="Header" inherits="DialogHeaderTemplate"/>
			<Button parentKey="CloseButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-2" y="-2"/>
				</Anchors>
			</Button>

			<Frame parentKey="WmoPanel" inherits="BackdropTemplate">
				<Size y="56"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="14" y="-32"/>
					<Anchor point="TOPRIGHT" x="-14" y="-32"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Name" inherits="GameFontHighlightLarge" justifyH="LEFT" wordwrap="false">
							<Anchors>
								<Anchor point="TOPLEFT" x="12" y="-12"/>
								<Anchor point="TOPRIGHT" x="-112" y="-12"/>
							</Anchors>
						</FontString>
						<FontString parentKey="Detail" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
							<Anchors>
								<Anchor point="TOPLEFT" x="12" y="-34"/>
								<Anchor point="TOPRIGHT" x="-12" y="-34"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<!-- A gameobject's entry: typed, the sets are its WMO's instead of the selected one's. -->
					<EditBox parentKey="Entry" inherits="InputBoxInstructionsTemplate" autoFocus="false" numeric="true" letters="10">
						<Size x="88" y="20"/>
						<Anchors>
							<Anchor point="TOPRIGHT" x="-14" y="-9"/>
						</Anchors>
					</EditBox>
				</Frames>
			</Frame>

			<Frame parentKey="SetsPanel" inherits="BackdropTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.WmoPanel" relativePoint="BOTTOMLEFT" y="-8"/>
					<Anchor point="BOTTOMRIGHT" x="-14" y="158"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Title" inherits="GameFontNormal">
							<Anchors>
								<Anchor point="TOP" y="-9"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Frame parentKey="ScrollBox" inherits="WowScrollBoxList">
						<Anchors>
							<Anchor point="TOPLEFT" x="8" y="-28"/>
							<Anchor point="BOTTOMRIGHT" x="-28" y="8"/>
						</Anchors>
					</Frame>
					<EventFrame parentKey="ScrollBar" inherits="WowTrimScrollBar">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="4" y="2"/>
							<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="4" y="-2"/>
						</Anchors>
					</EventFrame>
				</Frames>
			</Frame>

			<Frame parentKey="Options" inherits="BackdropTemplate">
				<Size y="108"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.SetsPanel" relativePoint="BOTTOMLEFT" y="-8"/>
					<Anchor point="TOPRIGHT" relativeKey="$parent.SetsPanel" relativePoint="BOTTOMRIGHT" y="-8"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Title" inherits="GameFontNormal">
							<Anchors>
								<Anchor point="TOP" y="-9"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<!-- Each choice's label and radio buttons are made in Window.lua from its CHOICES. -->
			</Frame>

			<StatusBar parentKey="Progress" minValue="0" maxValue="1" defaultValue="0" hidden="true">
				<Size y="12"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="18" y="16"/>
					<Anchor point="BOTTOMRIGHT" x="-126" y="16"/>
				</Anchors>
				<BarTexture file="Interface\Buttons\WHITE8X8"/>
				<BarColor r="0.85" g="0.65" b="0.13"/>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Background">
							<Anchors>
								<Anchor point="TOPLEFT" x="-1" y="1"/>
								<Anchor point="BOTTOMRIGHT" x="1" y="-1"/>
							</Anchors>
							<Color r="0" g="0" b="0" a="0.7"/>
						</Texture>
					</Layer>
					<Layer level="OVERLAY">
						<FontString parentKey="Text" inherits="GameFontHighlightSmall">
							<Anchors>
								<Anchor point="CENTER" y="1"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</StatusBar>
			<Button parentKey="SpawnButton" inherits="UIPanelButtonTemplate">
				<Size x="100" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-14" y="11"/>
				</Anchors>
			</Button>
		</Frames>
	</Frame>
</Ui>
